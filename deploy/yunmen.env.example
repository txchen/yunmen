# Copy to yunmen.env. This file holds no secrets.
YUNMEN_PUBLIC_ORIGIN=https://yunmen.example.com
YUNMEN_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
YUNMEN_ACCESS_AUD=replace-with-the-access-application-audience-tag
YUNMEN_ACCESS_OWNER_EMAILS=you@example.com
# Client IDs (not secrets) of service tokens allowed to pair CLI devices, comma separated.
YUNMEN_ACCESS_SERVICE_CLIENT_IDS=replace-with-client-id.access
